# ==========================================
# AITrip - Environment Configuration Template
# ==========================================

# 1. MapTiler (Global geocoding, satellite & vector globe maps)
MAPTILER_API_KEY=
VITE_MAPTILER_API_KEY=

# 2. Geoapify (Nearby attractions, POIs, place details)
GEOAPIFY_API_KEY=
VITE_GEOAPIFY_API_KEY=

# 3. AI / LangGraph (Groq Cloud)
GROQ_API_KEY=

# 4. AI Web Research (Tavily)
TAVILY_API_KEY=

# 5. Flights / Travel (Amadeus - Backend only)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# 6. Database (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql://user:password@localhost:5432/aitrip

# 7. Backend & Frontend Ports
PORT=8000
FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:8000