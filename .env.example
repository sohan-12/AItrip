# AITrip AI Travel Planner Environment Configuration

# 1. Google Maps Platform API Key (Optional but recommended for full Google Maps integration)
# Enables: Maps JavaScript API, Places API, Geocoding API
# Get one at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# 2. MapTiler API Key (Optional: for MapTiler WebGL satellite maps & vector tiles)
# Get a free key at: https://cloud.maptiler.com/
MAPTILER_API_KEY=
VITE_MAPTILER_API_KEY=

# 3. AI LLM Providers (Optional for LangGraph multi-agent reasoning, mock/heuristic agents work out-of-the-box)
GROQ_API_KEY=
OPENAI_API_KEY=

# 4. Open-Meteo & Wikipedia APIs
# NOTE: Open-Meteo (live weather) and Wikipedia / Wikimedia Commons (real high-res place photos)
# work 100% FREE with NO API KEY required!

# 5. Database URL (PostgreSQL for user & trip persistence, localStorage active by default)
DATABASE_URL=postgresql://user:password@localhost:5432/aitrip

# 6. Backend Port
PORT=8000

